    <Project Path="Source/Fylum.Migrations.SharedModels/Fylum.Migrations.SharedModels.csproj" />
  </Folder>
  <Folder Name="/Source/Client/" />
  <Folder Name="/Source/Client/Common/">
    <Project Path="Source/Fylum.Web.MaterialTheming/Fylum.Web.MaterialTheming.csproj" />
  </Folder>
  <Folder Name="/Source/Client/Fylum/">
    <Project Path="Source/Fylum.Client.Cli/Fylum.Client.Cli.csproj" />
    <Project Path="Source/Fylum.Client/Fylum.Client.csproj" />
    <Project Path="Source/Fylum.Web/Fylum.Web.csproj" />
  </Folder>
  <Folder Name="/Source/Client/Migrations/">
    <Project Path="Source/Fylum.Migrations.Client.Cli/Fylum.Migrations.Client.Cli.csproj" />
    <Project Path="Source/Fylum.Migrations.Client/Fylum.Migrations.Client.csproj" />
    <Project Path="Source/Fylum.Migrations.Web/Fylum.Migrations.Web.csproj" />
  </Folder>
  <Folder Name="/Test/" />
  <Folder Name="/Test/Architecture/">
    <Project Path="Test/Fylum.ArchitectureTest.Common/Fylum.ArchitectureTest.Common.csproj" />
