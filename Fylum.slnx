<Solution>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
  </Folder>
  <Folder Name="/Solution Items/GitHub/">
    <File Path=".github/dependabot.yml" />
  </Folder>
  <Folder Name="/Solution Items/GitHub/Workflows/">
    <File Path=".github/workflows/build-test.yml" />
    <File Path=".github/workflows/style-check.yml" />
  </Folder>
  <Folder Name="/Solution Items/Global Properties/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="nuget.config" />
  </Folder>
  <Folder Name="/Source/">
    <Project Path="Source/Fylum.AppHost/Fylum.AppHost.csproj" />
    <Project Path="Source/Fylum.ServiceDefaults/Fylum.ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/Source/Api/" />
  <Folder Name="/Source/Api/Common/">
    <Project Path="Source/Fylum.Core/Fylum.Core.csproj" />
  </Folder>
  <Folder Name="/Source/Api/Fylum/">
    <Project Path="Source/Fylum.Api/Fylum.Api.csproj" />
  </Folder>
  <Folder Name="/Source/Api/Fylum/Folders/">
    <Project Path="Source/Fylum.Folders.Api/Fylum.Folders.Api.csproj" />
