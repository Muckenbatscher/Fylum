  </Folder>
  <Folder Name="/Test/EndToEnd/">
    <Project Path="Test/Fylum.Api.EndToEndTest.Common/Fylum.Api.EndToEndTest.Common.csproj" />
    <Project Path="Test/Fylum.Folders.Api.EndToEnd.Tests/Fylum.Folders.Api.EndToEnd.Tests.csproj" />
